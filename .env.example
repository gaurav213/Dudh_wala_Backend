NODE_ENV=development
PORT=3000

# Public product name (user-facing). Repo/package names stay doodh-khata-*.
APP_NAME=Doodh Wala

API_PREFIX=api
API_VERSION=1

# Local Docker example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doodh_khata
# DATABASE_SSL=false
#
# Neon (pooled) — set the real URL only in local .env / Render dashboard. Never commit.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

JWT_ACCESS_SECRET=replace_with_secure_random_value
JWT_REFRESH_SECRET=replace_with_different_secure_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_ROUNDS=12
# Dev: localhost. Production: must set real https origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# When true, new farms skip PENDING_APPROVAL and become ACTIVE immediately.
# Local/dev environments should set this to `true` so newly created farms
# are immediately discoverable in marketplace search without needing a
# platform-owner approval step. Keep `false` in production.
AUTO_APPROVE_FARMS=false

# --- Optional integrations (do not commit real secrets) ---
# Firebase Admin (push notifications) — Phase 6
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
#
# S3-compatible object storage (media) — Phase 3/9
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
#
# Maps provider keys (Flutter/web clients) — Phase 4
# MAPS_API_KEY=
# VITE_MAPS_API_KEY=

# Payment provider (Phase 4+) — secrets stay server-side only
# PAYMENT_PROVIDER=razorpay
# PAYMENT_KEY_ID=replace_me
# PAYMENT_KEY_SECRET=replace_me
# PAYMENT_WEBHOOK_SECRET=replace_me

# Media / object storage (Phase 2+)
# MEDIA_PROVIDER=s3
# MEDIA_BUCKET=replace_me
# MEDIA_REGION=replace_me
# MEDIA_ACCESS_KEY_ID=replace_me
# MEDIA_SECRET_ACCESS_KEY=replace_me
# MEDIA_PUBLIC_BASE_URL=replace_me
