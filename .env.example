NODE_ENV=development
PORT=3000

API_PREFIX=api
API_VERSION=1

# Local Docker example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doodh_khata
# DATABASE_SSL=false
#
# Render External Database URL (set real value only in local .env — never commit):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

JWT_ACCESS_SECRET=replace_with_secure_random_value
JWT_REFRESH_SECRET=replace_with_different_secure_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# When true, new farms skip PENDING_APPROVAL and become ACTIVE immediately
AUTO_APPROVE_FARMS=false
